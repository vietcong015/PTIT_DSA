#include <iostream>
#include <vector>
using namespace std;

int n, m, timer_dfs = 0, scc_cnt = 0;
vector<vector<int>> adj;
vector<int> num, low, comp, stk;
vector<bool> on_stack;

void dfs(int u) {
    num[u] = low[u] = ++timer_dfs;
    stk.push_back(u);
    on_stack[u] = true;

    for (int v : adj[u]) {
        if (num[v] == 0) {
            dfs(v);
            if (low[v] < low[u]) low[u] = low[v];
        } else if (on_stack[v]) {
            if (num[v] < low[u]) low[u] = num[v];
        }
    }

    if (low[u] == num[u]) {
        scc_cnt++;
        while (true) {
            int v = stk.back();
            stk.pop_back();
            on_stack[v] = false;
            comp[v] = scc_cnt;
            if (v == u) break;
        }
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n >> m;
    adj.assign(n + 1, vector<int>());

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
    }

    num.assign(n + 1, 0);
    low.assign(n + 1, 0);
    comp.assign(n + 1, 0);
    on_stack.assign(n + 1, false);

    for (int i = 1; i <= n; i++) {
        if (num[i] == 0) {
            dfs(i);
        }
    }

    vector<int> in_deg(scc_cnt + 1, 0);
    for (int u = 1; u <= n; u++) {
        for (int v : adj[u]) {
            if (comp[u] != comp[v]) {
                in_deg[comp[v]]++;
            }
        }
    }

    int ans = 0;
    for (int c = 1; c <= scc_cnt; c++) {
        if (in_deg[c] == 0) {
            ans++;
        }
    }

    if (ans == 0 && n > 0) ans = 1;
    cout << ans << "\n";

    return 0;
}
