#include <iostream>
#include <vector>
#include <string>
using namespace std;

int n;
string t;
vector<string> b;
vector<string> cur;
vector<bool> used;

void sort_strings(vector<string>& v) {
    for (int i = 0; i < (int)v.size(); i++) {
        for (int j = i + 1; j < (int)v.size(); j++) {
            if (v[i] > v[j]) {
                string tmp = v[i];
                v[i] = v[j];
                v[j] = tmp;
            }
        }
    }
}

void backtrack() {
    if (cur.size() == b.size()) {
        for (int i = 0; i < (int)cur.size(); i++) {
            cout << cur[i] << " ";
        }
        cout << t << "\n";
        return;
    }

    for (int i = 0; i < (int)b.size(); i++) {
        if (!used[i]) {
            used[i] = true;
            cur.push_back(b[i]);
            backtrack();
            cur.pop_back();
            used[i] = false;
        }
    }
}

int main() {
    cin >> n;

    vector<string> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    cin >> t;

    for (int i = 0; i < n; i++) {
        if (a[i] != t) {
            b.push_back(a[i]);
        }
    }

    sort_strings(b);
    used.assign(b.size(), false);
    backtrack();

    return 0;
}
