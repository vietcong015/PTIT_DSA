#include <iostream>
#include <vector>
using namespace std;

long long len[46];
long long cntA[46];

long long solve(int n, long long k) {
    if (k <= 0) return 0;
    if (n == 0) return 1;
    if (n == 1) return 0;
    if (k <= len[n - 1]) {
        return solve(n - 1, k);
    }
    return cntA[n - 1] + solve(n - 2, k - len[n - 1]);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    len[0] = 1;
    len[1] = 1;
    cntA[0] = 1;
    cntA[1] = 0;

    for (int i = 2; i <= 45; i++) {
        len[i] = len[i - 1] + len[i - 2];
        cntA[i] = cntA[i - 1] + cntA[i - 2];
    }

    int t;
    cin >> t;
    while (t--) {
        int n;
        long long k;
        cin >> n >> k;
        cout << solve(n, k) << "\n";
    }

    return 0;
}
